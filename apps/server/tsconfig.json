{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "composite": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "useDefineForClassFields": false,
    "types": ["node"]
